    run_check transport-rust-bootstrap rustup run 1.97.1 cargo test -p gb-bootstrap \
        --all-targets --locked --offline || return 1
    run_check transport-rust-slice rustup run 1.97.1 cargo test -p gb-slice \
        --all-targets --locked --offline
}

