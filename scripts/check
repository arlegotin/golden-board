        python.tests.test_m2_route_v2 python.tests.test_m2_capacity_v2 \
        python.tests.test_m2_route_receiver_v2 python.tests.test_m2_route_semantics_v2 \
        python.tests.test_m2_knowledge_v2 python.tests.test_m2_technical_preview_v2 \
        python.tests.test_m2_program_refinement_v2 python.tests.test_m2_resources_v2 \
        python.tests.test_m2_receiver_bounds_v2 python.tests.test_m2_boundary_kat_v2 \
        python.tests.test_m2_decoder_bridge_v2 \
        python.tests.test_m2_damage_replay_v2 python.tests.test_m2_replay_damage_cli_v2 \
        python.tests.test_m2_decoder_v2 python.tests.test_m2_policy_v2 python.tests.test_m2_static_v2 \
        python.tests.test_m2_damage_v2 python.tests.test_m2_physical_v2 \
        python.tests.test_m2_transport_v2 python.tests.test_m2_carrier_v2 \
        python.tests.test_m2_runner python.tests.test_m2_runner_v1 python.tests.test_capacity \
        python.tests.test_m2_policy python.tests.test_m2_route_data \
        python.tests.test_m2_common_recipe \
        python.tests.test_m2_codec \
        python.tests.test_m2_recipe \
        python.tests.test_m2_carrier \
        python.tests.test_m2_decoder \
        python.tests.test_m2_gate8 \
        python.tests.test_m2_gate8_policy \
        python.tests.test_m2_gate8_policy_v2 python.tests.test_m2_source_v2 \
        python.tests.test_m2_gate8_receipts_v2 python.tests.test_m2_gate8_evidence_v2 \
        python.tests.test_m2_gate8_reports_v2 \
        python.tests.test_m2_execution_v2 python.tests.test_m2_pair_execution_v2 \
        python.tests.test_m2_pair_cancellation_v2 python.tests.test_m2_publication_v2 \
        python.tests.test_m2_publication_cancellation_v2 \
        python.tests.test_m2_command_execution_v2 python.tests.test_m2_execution_interop_v2 \
        python.tests.test_m2_workflow_execution_v2 \
        python.tests.test_m2_participant_bundle_v2 python.tests.test_m2_learner_assessment_v2 \
        python.tests.test_m2_first_use_v2 python.tests.test_m2_recovery_provenance_v2 \
        python.tests.test_m2_preflight_v2 python.tests.test_m2_complete_candidate_v2 \
        python.tests.test_m2_complete_damage_v2 python.tests.test_m2_independence_v2 \
        python.tests.test_m2_participant_revision_transition \
        python.tests.test_m2_learner_runner \
