damage() {
    candidate_root=$ROOT/artifacts/candidates/eh72-hier-r5-r2-r1-crc32c-v0
    if revision_v2; then
        printf '%s\n' 'check: historical damage outputs excluded from revised authority'
    elif [ -d "$candidate_root/damage" ]; then
        run_check damage-check "$GB_PYTHON" tools/m2/generate_damage.py --check || return 1
    else
        printf '%s\n' 'check: damage-check deferred to private Gate-8 regeneration'
    fi
    python_tests damage-python \
        python.tests.test_m2_damage \
        python.tests.test_m2_damage_v2 python.tests.test_m2_damage_oracle_v2 \
        python.tests.test_m2_complete_damage_v2 python.tests.test_m2_independence_v2 \
        python.tests.test_m2_complete_candidate_v2 \
        python.tests.test_m2_physical_v2 python.tests.test_m2_resources_v2 \
        python.tests.test_m2_receiver_bounds_v2 python.tests.test_m2_boundary_kat_v2 \
        python.tests.test_m2_decoder_bridge_v2 \
        python.tests.test_m2_damage_replay_v2 python.tests.test_m2_replay_damage_cli_v2 \
        python.tests.test_m2_decoder \
        python.tests.test_m2_independence || return 1
    run_check damage-rust rustup run 1.97.1 cargo test -p gb-bootstrap \
        --lib --locked --offline damage::tests || return 1
    run_check damage-rust-v1 rustup run 1.97.1 cargo test -p gb-bootstrap \
        --lib --locked --offline damage_v1::tests || return 1
    run_check damage-rust-independence-v1 rustup run 1.97.1 cargo test \
        -p gb-bootstrap --lib --locked --offline independence_v1::tests || return 1
    run_check damage-rust-oracle-v2 rustup run 1.97.1 cargo test -p gb-bootstrap \
        --lib --locked --offline damage_oracle_v2:: || return 1
    run_check damage-rust-revision rustup run 1.97.1 cargo test -p gb-bootstrap \
        --test damage_v2 --test damage_corpus_v2 --test damage_oracle_v2 \
        --test complete_damage_v2 --test independence_v2 \
        --test physical_v2 --test resources_v2 \
        --test receiver_bounds_v2 --test boundary_kat_v2 \
        --bin gb-revision-damage-decoder --locked --offline || return 1
    run_check damage-rust-bridge rustup run 1.97.1 cargo test -p gb-bootstrap \
        --bin gb-r3-damage-decoder --locked --offline || return 1
    run_check damage-rust-proof-cli rustup run 1.97.1 cargo test \
        -p gb-bootstrap --bin gb-r3-independence-proof --locked --offline
}

repo() {
    for shell_file in scripts/check tools/linux/acquire.sh \
        tools/linux/container-verify.sh tools/linux/verify.sh \
        tools/linux/container-verify-v2.sh tools/linux/verify-v2.sh; do
        run_check repo-shell sh -n "$shell_file" || return 1
    done
    run_check repo-rustfmt rustup run 1.97.1 cargo fmt --all --check || return 1
    run_check repo-working-diff git diff --check || return 1
    run_check repo-index-diff git diff --cached --check || return 1
    python_tests repo-python \
        python.tests.test_foundation.RepoContract \
        python.tests.test_foundation.RootCheckCLI \
        python.tests.test_m2_linux_execution_v2 \
        python.tests.test_m2_check_execution_v2 \
        python.tests.test_constants.ConstantsCodegen
}

# Internal prerequisite checks only. The v2 coordinator owns full/release
# outcomes and invokes this command before its fresh producer work.
components() {
    repo && identity && chess && chess_oracle && source_full && curriculum && \
        content && transport && damage
}

new_private_directory() {
    temp_root=$(CDPATH= cd -P "${TMPDIR:-/tmp}" 2>/dev/null && pwd -P) || return 1
    directory=$(mktemp -d "$temp_root/golden-board-gate8.XXXXXX") || return 1
    chmod 700 "$directory" || return 1
    printf '%s\n' "$directory"
}

remove_private_directory() {
    directory=$1
    temp_root=$(CDPATH= cd -P "${TMPDIR:-/tmp}" 2>/dev/null && pwd -P) || return 1
    case "$directory" in
        "$temp_root"/golden-board-gate8.*) ;;
        *) return 1 ;;
    esac
    rm -rf "$directory"
}

gate8_phase() {
    result=0
    report=$ROOT/reports/m2-feasibility-v0.json
    gate8=$ROOT/artifacts/gate8
    if [ "${GB_M2_LINUX_CANDIDATE_READY:-0}" = 1 ]; then
        [ -f "$report" ] || fail 'gate8: clean-Linux Candidate-ready report is missing'
        [ ! -e "$gate8" ] || fail 'gate8: ignored retained tree entered clean Linux'
        [ "${GB_M2_GATE8_NATIVE_INPUT:-}" = /gate8-native-input ] || \
            fail 'gate8: clean-Linux native input mount is missing'
        [ "${GB_M2_GATE8_LINUX_OUTPUT:-}" = /gate8-output ] || \
            fail 'gate8: clean-Linux receipt output mount is missing'
        candidate=$(new_private_directory) || return 1
        work=$(new_private_directory) || {
            remove_private_directory "$candidate"
            return 1
        }
        run_check gate8-linux-candidate-ready "$GB_PYTHON" \
            tools/m2/generate_gate8.py verify-linux \
            --candidate-root "$candidate" \
            --native-input-dir /gate8-native-input \
            --linux-output-dir /gate8-output \
            --gate8-work-root "$work"
        result=$?
        remove_private_directory "$candidate" || result=1
        remove_private_directory "$work" || result=1
        return "$result"
    fi
    if [ ! -e "$report" ] && [ ! -e "$gate8" ]; then
        candidate=$(new_private_directory) || return 1
        run_check gate8-pre-report "$GB_PYTHON" tools/m2/generate_gate8.py \
            phase-check --phase pre-gate8-clean --candidate-root "$candidate"
        result=$?
        remove_private_directory "$candidate" || result=1
        return "$result"
    fi
    [ -f "$report" ] && [ -d "$gate8" ] || fail 'gate8: partial lifecycle state'
    receipts=${GB_M2_RELEASE_NATIVE_RECEIPTS:-}
    owned_receipts=0
    if [ -z "$receipts" ]; then
        receipts=$(new_private_directory) || return 1
        owned_receipts=1
    else
        case "$receipts" in /*) ;; *) fail 'gate8: release receipt directory is not absolute' ;; esac
        [ -d "$receipts" ] || fail 'gate8: release receipt directory is missing'
        [ -z "$(find "$receipts" -mindepth 1 -maxdepth 1 -print -quit)" ] || \
            fail 'gate8: release receipt directory is not empty'
    fi
    if ! cp "$gate8/receipts/linux-python.json" "$receipts/linux-python.json" || \
        ! cp "$gate8/receipts/linux-rust.json" "$receipts/linux-rust.json"
    then
        [ "$owned_receipts" -eq 0 ] || remove_private_directory "$receipts"
        return 1
    fi
    candidate_python=$(new_private_directory) || {
        [ "$owned_receipts" -eq 0 ] || remove_private_directory "$receipts"
        return 1
    }
    candidate_rust=$(new_private_directory) || {
        remove_private_directory "$candidate_python"
        [ "$owned_receipts" -eq 0 ] || remove_private_directory "$receipts"
        return 1
    }
    candidate_assembly=$(new_private_directory) || {
        remove_private_directory "$candidate_python"
        remove_private_directory "$candidate_rust"
        [ "$owned_receipts" -eq 0 ] || remove_private_directory "$receipts"
        return 1
    }
    run_check gate8-native-python "$GB_PYTHON" tools/m2/generate_gate8.py \
        producer --mode generate --producer-id native-python \
        --candidate-root "$candidate_python" --output-dir "$receipts" || result=$?
    result=${result:-0}
    if [ "$result" -eq 0 ]; then
        run_check gate8-rust-build rustup run 1.97.1 cargo build -p gb-bootstrap \
            --bin gb-m2-gate8 --release --locked --offline || result=$?
    fi
    if [ "$result" -eq 0 ]; then
        run_check gate8-native-rust "$ROOT/target/release/gb-m2-gate8" \
            producer --mode generate --producer-id native-rust \
            --candidate-root "$candidate_rust" --output-dir "$receipts" || result=$?
    fi
    if [ "$result" -eq 0 ]; then
        run_check gate8-host-candidate-ready "$GB_PYTHON" \
            tools/m2/generate_gate8.py assemble --mode check \
            --candidate-root "$candidate_assembly" --receipt-dir "$receipts" \
            --output-dir "$gate8" --report-out "$report" || result=$?
    fi
    remove_private_directory "$candidate_python" || result=1
    remove_private_directory "$candidate_rust" || result=1
    remove_private_directory "$candidate_assembly" || result=1
    if [ "$owned_receipts" -eq 1 ]; then
        remove_private_directory "$receipts" || result=1
    fi
    return "$result"
}

release_freeze() {
    report=$ROOT/reports/m2-feasibility-v0.json
    [ -f "$report" ] || fail 'release: Candidate-ready report is missing'
    after=$(shasum -a 256 "$report") || return 1
    [ "$after" = "$GB_M2_RELEASE_REPORT_SHA256" ] || \
        fail 'release: report changed during verification'
    for forbidden in release web .github/workflows schemas reports/release-summary.json; do
        [ ! -e "$ROOT/$forbidden" ] || fail "release: premature path $forbidden"
    done
}

release() {
    if revision_v2; then
        exec "$GB_PYTHON" tools/m2/verify_gate8_v2.py release
    fi
    report=$ROOT/reports/m2-feasibility-v0.json
    [ -f "$report" ] || fail 'release: Candidate-ready report is missing'
    GB_M2_RELEASE_REPORT_SHA256=$(shasum -a 256 "$report") || return 1
    export GB_M2_RELEASE_REPORT_SHA256
    receipts=$(new_private_directory) || return 1
    GB_M2_RELEASE_NATIVE_RECEIPTS=$receipts
    export GB_M2_RELEASE_NATIVE_RECEIPTS
    repo && identity && chess && chess_oracle && source_full && curriculum && \
        content && transport && damage && gate8_phase
    result=$?
    if [ "$result" -eq 0 ]; then
        run_check release-linux "$ROOT/tools/linux/verify.sh" || result=$?
    fi
    if [ "$result" -eq 0 ]; then
        release_freeze || result=$?
    fi
    remove_private_directory "$receipts" || result=1
    unset GB_M2_RELEASE_NATIVE_RECEIPTS GB_M2_RELEASE_REPORT_SHA256
    return "$result"
}

case "$mode" in
    identity) identity ;;
    chess) chess ;;
    source) source_full ;;
    curriculum) curriculum ;;
    content) content ;;
    transport) transport ;;
    damage) damage ;;
    repo) repo ;;
    fast) repo && identity && chess && source_fast && curriculum && content && transport_fast ;;
    components) components ;;
    full)
        if revision_v2; then
            exec "$GB_PYTHON" tools/m2/verify_gate8_v2.py full
        fi
        repo && identity && chess && chess_oracle && source_full && curriculum && content && transport && damage && gate8_phase ;;
    release) release ;;
esac
