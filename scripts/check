#!/bin/sh -p
case $- in
    *p*) ;;
    *) printf '%s\n' 'privileged shell mode is required' >&2; exit 1 ;;
esac
gb_script=$0
gb_bootstrap_path=${PATH-}
gb_clean_linux=${GB_CLEAN_LINUX_DIGEST-}
unset CDPATH ENV BASH_ENV POSIXLY_CORRECT
unset PYTHONHOME PYTHONPATH PYTHONSTARTUP PYTHONINSPECT PYTHONWARNINGS PYTHONBREAKPOINT PYTHONSAFEPATH
unset _PYTHON_SYSCONFIGDATA_NAME
unset UV_CONFIG_FILE UV_PROJECT UV_WORKING_DIR UV_PYTHON UV_PYTHON_PREFERENCE
unset UV_PROJECT_ENVIRONMENT UV_CACHE_DIR UV_PYTHON_INSTALL_DIR UV_MANAGED_PYTHON
unset UV_OFFLINE UV_PYTHON_DOWNLOADS UV_INDEX UV_DEFAULT_INDEX UV_INDEX_URL UV_EXTRA_INDEX_URL
unset UV_FIND_LINKS PIP_INDEX_URL PIP_EXTRA_INDEX_URL PIP_CONFIG_FILE
unset CARGO_HOME CARGO_TARGET_DIR CARGO_NET_OFFLINE CARGO_CACHE_AUTO_CLEAN_FREQUENCY CARGO_BUILD_TARGET CARGO_ENCODED_RUSTFLAGS
unset CARGO_TARGET_AARCH64_APPLE_DARWIN_LINKER CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER
unset CARGO_BUILD_RUSTC CARGO_BUILD_RUSTC_WRAPPER CARGO_BUILD_RUSTFLAGS
unset CARGO_REGISTRIES_CRATES_IO_INDEX CARGO_REGISTRIES_CRATES_IO_PROTOCOL
unset RUSTC RUSTDOC RUSTFLAGS RUSTDOCFLAGS RUSTC_WRAPPER RUSTC_WORKSPACE_WRAPPER RUSTUP_HOME
unset CC CXX CPPFLAGS CFLAGS CXXFLAGS LDFLAGS COMPILER_PATH SDKROOT MACOSX_DEPLOYMENT_TARGET
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
unset GIT_CONFIG GIT_CONFIG_COUNT GIT_CONFIG_PARAMETERS GIT_CONFIG_SYSTEM GIT_CONFIG_GLOBAL
unset GIT_CONFIG_NOSYSTEM GIT_CEILING_DIRECTORIES GIT_COMMON_DIR GIT_NO_LAZY_FETCH GIT_OPTIONAL_LOCKS
unset GIT_SSH GIT_SSH_COMMAND GIT_ASKPASS SSH_ASKPASS GIT_TERMINAL_PROMPT GIT_CREDENTIAL_HELPER
unset DYLD_INSERT_LIBRARIES DYLD_LIBRARY_PATH DYLD_FRAMEWORK_PATH DYLD_FALLBACK_LIBRARY_PATH
unset DYLD_FALLBACK_FRAMEWORK_PATH DYLD_VERSIONED_LIBRARY_PATH DYLD_VERSIONED_FRAMEWORK_PATH
unset DYLD_IMAGE_SUFFIX DYLD_ROOT_PATH DYLD_FORCE_FLAT_NAMESPACE DYLD_SHARED_REGION
unset DYLD_SHARED_CACHE_DIR DYLD_PRINT_TO_FILE LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT
unset LD_DEBUG_OUTPUT LD_PROFILE LD_PROFILE_OUTPUT LIBPATH SHLIB_PATH
unset HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy
unset SSL_CERT_FILE SSL_CERT_DIR REQUESTS_CA_BUNDLE CURL_CA_BUNDLE
unset DOCKER_HOST DOCKER_CONTEXT DOCKER_CONFIG DOCKER_TLS_VERIFY DOCKER_CERT_PATH DOCKER_API_VERSION
unset DOCKER_CONTENT_TRUST DOCKER_DEFAULT_PLATFORM DOCKER_CLI_HINTS DOCKER_CLI_EXPERIMENTAL
unset DOCKER_CUSTOM_HEADERS BUILDX_CONFIG BUILDX_BUILDER
unset GB_BOOTSTRAP_CARGO_FMT GB_BOOTSTRAP_DOCKER GB_BOOTSTRAP_GIT GB_BOOTSTRAP_RUSTDOC GB_CLEAN_LINUX_DIGEST
unset SHELLOPTS 2>/dev/null || :
unset BASHOPTS 2>/dev/null || :
set -eu
PATH=$gb_bootstrap_path
LANG=C
LC_ALL=C
TZ=UTC
export PATH LANG LC_ALL TZ
case $gb_script in
    /*) ;;
    *) gb_script=$PWD/$gb_script ;;
esac
cd -P "${gb_script%/*}/.."
gb_root=$PWD
gb_python=$(command -v python3.14)
gb_uv=$(command -v uv)
gb_cargo=$(command -v cargo)
gb_rustc=$(command -v rustc)
gb_rustfmt=$(command -v rustfmt)
gb_git=$(command -v git)
for gb_tool in "$gb_python" "$gb_uv" "$gb_cargo" "$gb_rustc" "$gb_rustfmt" "$gb_git"; do
    case $gb_tool in /*) ;; *) exit 1 ;; esac
done
gb_docker=
if [ "$#" -eq 2 ] && [ "environment" = "$1" ] && [ "verify-linux" = "$2" ]; then
    gb_docker=$(command -v docker)
    case $gb_docker in /*) ;; *) exit 1 ;; esac
    GB_BOOTSTRAP_DOCKER=$gb_docker
    export GB_BOOTSTRAP_DOCKER
fi
GB_CLEAN_LINUX_DIGEST=$gb_clean_linux
export GB_CLEAN_LINUX_DIGEST
exec "$gb_python" -I -S -B "$gb_root/python/golden_board/bootstrap.py" "check" "$gb_root" "$gb_python" "$gb_uv" "$gb_cargo" "$gb_rustc" "$gb_rustfmt" "$gb_git" "$@"
