#!/bin/sh

usage() {
    printf '%s\n' \
        'usage: scripts/check fast' \
        '       scripts/check focused source' \
        '       scripts/check focused identity' \
        '       scripts/check focused chess' \
        '       scripts/check focused curriculum' \
        '       scripts/check focused content' \
        '       scripts/check focused transport' \
        '       scripts/check focused damage' \
        '       scripts/check focused repo' \
        '       scripts/check linux' \
        '       scripts/check components' \
        '       scripts/check full' \
        '       scripts/check release' >&2
}

case "$#:$1" in
    1:fast|1:full|1:linux|1:release|1:components) mode=$1 ;;
    2:focused)
        case "$2" in
            source|identity|chess|curriculum|content|transport|damage|repo) mode=$2 ;;
            *) usage; exit 2 ;;
        esac
        ;;
    *) usage; exit 2 ;;
esac

case "$0" in
    */*) script_path=$0 ;;
    *) script_path=$(command -v "$0") || exit 1 ;;
esac
SCRIPT_DIR=$(CDPATH= cd "${script_path%/*}" && pwd) || exit 1
ROOT=$(CDPATH= cd "$SCRIPT_DIR/.." && pwd) || exit 1
cd "$ROOT" || exit 1
PYTHONPATH="$ROOT/python"
export PYTHONPATH

fail() {
    printf 'check: %s\n' "$1" >&2
    exit 1
}

run_check() {
    label=$1
    shift
    printf 'check: %s\n' "$label"
    if ! "$@"; then
        printf 'check: %s failed\n' "$label" >&2
        return 1
    fi
}

revision_v2() {
    { [ -f "$ROOT/docs/roadmap.md" ] && \
        grep -F -x '| Roadmap revision | 11 |' "$ROOT/docs/roadmap.md" >/dev/null; } || \
        [ -e "$ROOT/artifacts/history/m2-pre-participant-revision-v1" ] || \
        [ -L "$ROOT/artifacts/history/m2-pre-participant-revision-v1" ]
}

# The independent verifier intentionally dispatches before host language
# preflight. Its host surface is Git, Docker, and this POSIX shell only.
if [ "$mode" = linux ]; then
    exec "$ROOT/tools/linux/verify.sh"
fi

for tool in git uv rustup; do
    command -v "$tool" >/dev/null 2>&1 || fail "preflight: missing $tool"
done
case "$(uv --version 2>/dev/null)" in
    "uv 0.11.29"|"uv 0.11.29 "*) ;;
    *) fail "preflight: expected uv 0.11.29" ;;
esac
if ! uv run --locked --offline --no-python-downloads python -c \
    'import sys; raise SystemExit(sys.version_info[:3] != (3, 14, 6))'
then
    fail "preflight: expected CPython 3.14.6; run uv python install 3.14.6"
fi
GB_PYTHON="$ROOT/.venv/bin/python"
export GB_PYTHON
RUSTC=$(rustup which --toolchain 1.97.1 rustc 2>/dev/null) || \
    fail "preflight: install Rust 1.97.1 with rustfmt"
export RUSTC
CARGO_INCREMENTAL=0
export CARGO_INCREMENTAL
case "$("$RUSTC" --version 2>/dev/null)" in
    "rustc 1.97.1 "*) ;;
    *) fail "preflight: expected rustc 1.97.1" ;;
esac
case "$(rustup run 1.97.1 cargo --version 2>/dev/null)" in
    "cargo 1.97.1 "*) ;;
    *) fail "preflight: expected cargo 1.97.1" ;;
esac
printf 'check: preflight (%s)\n' "$(git --version)"

python_tests() {
    test_label=$1
    shift
    run_check "$test_label" uv run --locked --offline --no-python-downloads \
        python -m unittest -v "$@"
}

identity() {
    python_tests identity-python \
        python.tests.test_foundation.FoundationModulesPresent \
        python.tests.test_foundation.IdentityConformance \
        python.tests.test_foundation.ManifestConformance || return 1
    run_check identity-rust rustup run 1.97.1 cargo test -p gb-foundation \
        --all-targets --locked --offline -- --skip source_report_is_canonical
}

chess() {
    python_tests chess-python python.tests.test_chess || return 1
    run_check chess-rust rustup run 1.97.1 cargo test -p gb-chess \
        --test chess --locked --offline
}

chess_oracle() {
    run_check chess-oracle uv run --locked --offline --no-python-downloads \
        --group oracle python -m unittest -v python.tests.test_chess_oracle
}

source_full() {
    python_tests source-python \
        python.tests.test_foundation.SourceDoctorTrustBoundary \
        python.tests.test_foundation.SourceDoctorScanner \
        python.tests.test_foundation.SourceDoctorEvidence \
        python.tests.test_source_compiler || return 1
    run_check source-doctor-rust rustup run 1.97.1 cargo test -p gb-foundation \
        --test conformance --locked --offline source_report_is_canonical || return 1
    run_check source-rust rustup run 1.97.1 cargo test -p gb-chess \
        --test source --locked --offline
}

source_fast() {
    python_tests source-current \
        python.tests.test_foundation.SourceDoctorFast \
        python.tests.test_source_compiler.SourceCompilerApi.test_fixture_operation_inventory_is_closed
}

curriculum() {
    python_tests curriculum-python \
        python.tests.test_curriculum_contract \
        python.tests.test_curriculum
}

content() {
    python_tests content-python python.tests.test_content || return 1
    run_check content-rust rustup run 1.97.1 cargo test -p gb-content \
        --test content --locked --offline
}

transport() {
    candidate_root=$ROOT/artifacts/candidates/eh72-hier-r5-r2-r1-crc32c-v0
    if revision_v2; then
        printf '%s\n' 'check: historical transport candidate excluded from revised authority'
    elif [ -d "$candidate_root" ]; then
        run_check transport-r3-candidate uv run --locked --offline \
            --no-python-downloads python tools/m2/generate_candidates.py \
            --check || return 1
    else
        printf '%s\n' 'check: transport-r3-candidate deferred to private Gate-8 regeneration'
    fi
    python_tests transport-python \
        python.tests.test_bootstrap python.tests.test_m2_slice \
        python.tests.test_bootstrap_v2 python.tests.test_body_codec_v1 \
